{{/*
Resolve one managed Zellij plugin's absolute wasm path.

Context:
  root     the caller's root template context (`$`)
  plugin   one entry from .zellijPlugins

Zellij keys its permission cache by this bare absolute path
(RunPluginLocation::File's Display impl drops any `file:` prefix),
so it must match exactly what config.kdl / layouts load.
*/ -}}
{{- $plugin := .plugin -}}
{{- joinPath .root.chezmoi.homeDir ".config/zellij/plugins" $plugin.wasm -}}
